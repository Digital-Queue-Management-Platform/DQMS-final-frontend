{
  "name": "digital-queue-frontend",
  "version": "1.0.0",
  "description": "Customer Service Officer Dashboard for Digital Queue Management Platform",
  "author": "SLT-MOBITEL",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "electron:dev": "set VITE_ELECTRON=true && vite",
    "electron:build": "set VITE_ELECTRON=true && vite build && npx electron-builder --win"
  },
  "build": {
    "appId": "com.dqmp.officer.dashboard",
    "productName": "DQMP",
    "directories": {
      "output": "dist_dqmp"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    }
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.21",
    "axios": "^1.6.2",
    "framer-motion": "^12.37.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.294.0",
    "qrcode.react": "^3.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.5.0",
    "react-is": "^19.2.0",
    "react-router-dom": "^6.30.1",
    "react-window": "^1.8.10",
    "recharts": "^3.2.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/react-window": "^1.8.8",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "baseline-browser-mapping": "^2.9.7",
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
